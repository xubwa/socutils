+def run_fd_ket(intor, intor0, thr=1e-5, h=1e-5):
+    '''Check <nabla_a i|...|nabla_b j> (component 3a+b) against central differences of
+    <nabla_a i|...|j> (intor0) in the ket centre: with j on atom 1 and neither i nor k
+    there, -d/dR_j,b intor0 == intor exactly.'''
+    print(intor, '(finite differences of %s in the ket centre)' % intor0)
+    fn1 = getattr(_cint, 'c%s_sph' % intor)
+    fn0 = getattr(_cint, 'c%s_sph' % intor0)
+    atm = mol._atm
+    bas = mol._bas
+    env = mol._env.copy()
+    c_atm = atm.ctypes.data_as(ctypes.c_void_p)
+    c_bas = bas.ctypes.data_as(ctypes.c_void_p)
+    c_env = env.ctypes.data_as(ctypes.c_void_p)
+    c_natm = ctypes.c_int(mol.natm)
+    c_nbas = ctypes.c_int(mol.nbas)
+    PTR_COORD = 1
+    failed = False
+    ibas = [n for n in range(mol.nbas) if bas[n,0] == 0]
+    jbas = [n for n in range(mol.nbas) if bas[n,0] == 1]
+    kbas = [n for n in range(mol.nbas) if bas[n,0] in (2, 3)]
+    for i in ibas:
+        di = (bas[i,1]*2+1) * bas[i,3]
+        for j in jbas:
+            dj = (bas[j,1]*2+1) * bas[j,3]
+            for k in kbas:
+                dk = (bas[k,1]*2+1) * bas[k,3]
+                buf = numpy.empty((9,dk,dj,di))
+                fn1(buf.ctypes.data_as(ctypes.c_void_p),
+                    (ctypes.c_int*3)(i,j,k),
+                    c_atm, c_natm, c_bas, c_nbas, c_env, lib.c_null_ptr())
+                bp = numpy.empty((3,dk,dj,di))
+                bm = numpy.empty((3,dk,dj,di))
+                fd = numpy.empty_like(buf)
+                ptr = atm[1,PTR_COORD]
+                for d in range(3):
+                    x0 = env[ptr+d]
+                    env[ptr+d] = x0 + h
+                    fn0(bp.ctypes.data_as(ctypes.c_void_p),
+                        (ctypes.c_int*3)(i,j,k),
+                        c_atm, c_natm, c_bas, c_nbas, c_env, lib.c_null_ptr())
+                    env[ptr+d] = x0 - h
+                    fn0(bm.ctypes.data_as(ctypes.c_void_p),
+                        (ctypes.c_int*3)(i,j,k),
+                        c_atm, c_natm, c_bas, c_nbas, c_env, lib.c_null_ptr())
+                    env[ptr+d] = x0
+                    for a in range(3):
+                        fd[3*a+d] = -(bp[a] - bm[a]) / (2*h)
+                if numpy.abs(buf-fd).max() > thr:
+                    print(intor, '| fd', i, j, k, numpy.abs(buf-fd).max())
+                    failed = True
+    if failed:
+        print('failed')
+        exit(1)
+    else:
+        print('pass')
+
 run('int3c1e')
