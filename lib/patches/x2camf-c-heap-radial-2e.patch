                array_angular_Kpm[LmaxK[2] - LminK[2] + 1][size_tmp_p][size_tmp_q];
         double array_angular_Jpp[LmaxJ[3] - LminJ[3] + 1][size_tmp_p][size_tmp_q],
                array_angular_Kpp[LmaxK[3] - LminK[3] + 1][size_tmp_p][size_tmp_q];
